BRAINAPI_URL=http://localhost:8000
BRAINPAT_TOKEN=

# Dual profile: product (greedy) | sota (deepseek-v4-flash + SC + gap-fill)
# BENCH_PROFILE=product
# BENCH_PROFILE=sota
# BENCH_SC_SAMPLES=5
# BENCH_SC_TEMPERATURE=0.7
# BENCH_GAP_FILL=1
# Optional overrides (default SOTA answerer is deepseek-v4-flash):
# BENCH_SOTA_ANSWER_MODEL=deepseek-v4-flash
# BENCH_SOTA_JUDGE_MODEL=deepseek-v4-flash

# DeepSeek (OpenAI-compatible). Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
BENCH_LLM_BASE_URL=https://api.deepseek.com
BENCH_ANSWER_MODEL=deepseek-v4-flash

# The judge must be a different model family from the answerer, or judge accuracy
# carries self-preference bias. Leave BENCH_JUDGE_MODEL unset to auto-select the
# Azure deployment below; set it explicitly to pin a judge.
# BENCH_JUDGE_MODEL=
# BENCH_JUDGE_BASE_URL=
# BENCH_JUDGE_API_KEY=

# Azure OpenAI judge (falls back to the repo-root AZURE_LARGE_LLM_* variables):
# BENCH_JUDGE_AZURE_ENDPOINT=
# BENCH_JUDGE_AZURE_KEY=
# BENCH_JUDGE_AZURE_API_VERSION=2024-12-01-preview

# Optional aliases if you prefer another OpenAI-compatible provider:
# OPENAI_API_KEY=
# BENCH_LLM_BASE_URL=https://api.openai.com/v1
# BENCH_ANSWER_MODEL=gpt-4o-mini
